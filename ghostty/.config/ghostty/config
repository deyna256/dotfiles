# Ghostty owns the outer terminal; tmux owns panes and sessions.

# tmux is started directly. The login zsh that used to sit in between existed
# only to exec tmux, and paid for /etc/profile on the way (169ms per window on
# this machine). The fallback keeps the terminal usable if tmux ever fails.
# tmux is not exec'd: a failed exec would take the shell down with it, and
# the fallback would never run. The leftover /bin/sh costs nothing.
command = /bin/sh -c "tmux new-session -A -s main || exec zsh"

# ---- Font ----
# The Nerd Font variant carries the glyphs powerlevel10k draws; without it
# fontconfig silently substitutes another Nerd font at a different width.
font-family = JetBrainsMono Nerd Font
font-size = 12.5

# ---- Appearance ----
theme = Adventure
window-decoration = none
window-padding-x = 8
window-padding-y = 8
window-width = 120
window-height = 34

# ---- Behaviour ----
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# TERM stays xterm-ghostty for full local capabilities. ssh-terminfo installs
# that terminfo on remote hosts on first connect and falls back to
# xterm-256color if it cannot, which is what the VPS work needs.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
